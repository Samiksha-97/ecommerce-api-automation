<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="ECommerce API Test Suite"
       parallel="false">

    <test name="Authentication Tests">
        <packages>
            <package name="com.ecommerce.api.tests.auth"/>
        </packages>
    </test>

    <test name="Product Tests">
        <packages>
            <package name="com.ecommerce.api.tests.products"/>
        </packages>
    </test>

    <test name="User Tests">
        <packages>
            <package name="com.ecommerce.api.tests.user"/>
        </packages>
    </test>

    <test name="Order Tests">
        <packages>
            <package name="com.ecommerce.api.tests.order"/>
        </packages>
    </test>

    <test name="Negative Tests">
        <packages>
            <package name="com.ecommerce.api.tests.negative"/>
        </packages>
    </test>

    <test name="Payment Tests">
        <packages>
            <package name="com.ecommerce.api.tests.payment"/>
        </packages>
    </test>

    <test name="Workflow Tests">
        <packages>
            <package name="com.ecommerce.api.tests.workflow"/>
        </packages>
    </test>

</suite>