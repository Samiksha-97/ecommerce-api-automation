<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM
        "https://testng.org/testng-1.0.dtd">

<suite name="ECommerce API Regression Suite"
       parallel="false">

    <groups>
        <run>
            <include name="regression"/>
        </run>
    </groups>

    <test name="Regression Tests">
        <packages>
            <package name="com.ecommerce.api.tests.auth"/>
            <package name="com.ecommerce.api.tests.order"/>
            <package name="com.ecommerce.api.tests.products"/>
            <package name="com.ecommerce.api.tests.user"/>
            <package name="com.ecommerce.api.tests.negative"/>
            <package name="com.ecommerce.api.tests.workflow"/>
        </packages>
    </test>

</suite>